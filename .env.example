# Copy this file to ".env" and fill in your values. DO NOT commit the real token.

# ---- Required ----
OANDA_API_TOKEN=paste-your-api-token-here
OANDA_ACCOUNT_ID=paste-your-account-id-here   # e.g. 001-1234567-1234567890

# ---- Environment ----
OANDA_ENV=practice        # practice = demo | trade = live

# ---- Instrument ----
OANDA_INSTRUMENT=EUR_USD

# ---- The $1 test ----
STARTING_BALANCE=1.00     # reference "risk budget" for % reporting

# ---- Cumulative stop limits (whichever is hit first stops the bot) ----
MAX_LOSS=100.00           # STOP when cumulative LOSS >= this ($)
PROFIT_TARGET=100.00      # STOP when cumulative PROFIT >= this ($)

# ---- Order placement ----
OFFSET_PIPS=15            # pips above/below market for the two legs
UNITS=1000                # per leg (1000 = 0.01 lots -> tiny for the $1 test)
ENTRY_MODE=hedge          # hedge (open both at market) | straddle (breakout stops)

# ---- Control loop ----
POLL_INTERVAL=5           # seconds between checks
MIN_POSITION_SHIFT=10     # pips a side must lose before we flip it
STOP_AFTER_ITERATIONS=0   # 0 = run until target / loss cap / Ctrl-C

# ---- Logging ----
VERBOSE=1
LOG_FILE=flip_bot.log
